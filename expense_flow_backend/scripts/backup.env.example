# Backup Configuration
# Copy this file to backup.env and customize the values
# Then source it before running backup scripts: source backup.env

# NAS SSH user for backups
BACKUP_NAS_USER=service-backup

# NAS IP address or hostname
BACKUP_NAS_HOST=192.168.50.85

# Backup directory path on NAS
BACKUP_NAS_PATH=/srv/dev-disk-by-uuid-624a350d-6ef6-4894-8082-22ba887a922d/Backups/expense_flow/

# Maximum number of backups to keep (older backups will be deleted)
BACKUP_MAX_BACKUPS=14

# Optional: Path to SSH private key (leave empty to use default ~/.ssh keys)
# BACKUP_SSH_KEY=/path/to/private/key
