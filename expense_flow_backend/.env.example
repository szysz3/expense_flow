# DATABASE section
DATABASE_DB_PATH=.data/serve/receipts.sqlite3
DATABASE_TEMP_DB_PATH=.data/serve/temp_receipts.sqlite3

# AZURE section
AZURE_ENDPOINT=https://your-azure-endpoint.cognitiveservices.azure.com/
AZURE_KEY=your-azure-key

# LLM section
LLM_TYPE=local
LLM_OLLAMA_HOST=http://your-ollama-host:11434
LLM_OLLAMA_MODEL=Bielik-11B-v2.3-Instruct-GGUF:Q6_K
LLM_OLLAMA_FALLBACK_MODEL=hf.co/unsloth/phi-4-GGUF:Q5_K_M
LLM_CHATGPT_KEY=your-chatgpt-key

# API section
API_API_KEY=your-api-key
API_MAX_RETRIES=3
API_RETRY_DELAY=1.0
